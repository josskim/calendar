generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model reservation {
  id             BigInt   @id @default(autoincrement())
  type           String
  category       String
  use_date       DateTime
  nights         Int
  quantity       Int
  guest_name     String
  phone          String
  people_count   Int
  user_type      String
  total_amount   Int
  extra_amount   Int      @default(0)
  payment_status String
  deposit_date   DateTime
  cancel_date    DateTime
  source         String
  memo           String
  booking_group_id String?  @db.Uuid
  external_ref    String?
  sync_version    Int       @default(1)
  sync_verified_at DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("reservations")
}

model inventory_event {
  id               BigInt    @id @default(autoincrement())
  event_type       String
  booking_group_id String?   @db.Uuid
  reservation_ids  Json
  reservation_version Int    @default(1)
  payload          Json
  status           String    @default("pending")
  attempt_count    Int       @default(0)
  available_at     DateTime  @default(now())
  claimed_at       DateTime?
  completed_at     DateTime?
  last_error       String?
  result           Json?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([status, available_at, id])
  @@index([booking_group_id, id])
  @@map("inventory_events")
}

model admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admin")
}

model holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  name      String
  source    String   @default("custom")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("holidays")
}
