generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  schemas  = ["calendar"]
}

model reservation {
  id             BigInt   @id @default(autoincrement())
  type           String
  category       String
  use_date       DateTime
  nights         Int
  quantity       Int
  guest_name     String
  phone          String
  people_count   Int
  user_type      String
  total_amount   Int
  extra_amount   Int      @default(0)
  payment_status String
  deposit_date   DateTime
  cancel_date    DateTime
  source         String
  memo           String
  booking_group_id String?  @db.Uuid
  external_ref    String?
  sync_version    Int       @default(1)
  sync_verified_at DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("reservations")
  @@schema("calendar")
}

model inventory_event {
  id               BigInt    @id @default(autoincrement())
  event_type       String
  booking_group_id String?   @db.Uuid
  reservation_ids  Json
  reservation_version Int    @default(1)
  payload          Json
  status           String    @default("pending")
  attempt_count    Int       @default(0)
  available_at     DateTime  @default(now())
  claimed_at       DateTime?
  completed_at     DateTime?
  last_error       String?
  result           Json?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([status, available_at, id])
  @@index([booking_group_id, id])
  @@map("inventory_events")
  @@schema("calendar")
}

model inventory_audit_job {
  id               BigInt    @id @default(autoincrement())
  from_date        DateTime  @db.Date
  to_date          DateTime  @db.Date
  status           String    @default("pending")
  total_checks     Int       @default(0)
  completed_checks Int       @default(0)
  normal_count     Int       @default(0)
  critical_count   Int       @default(0)
  warning_count    Int       @default(0)
  error_count      Int       @default(0)
  current_target   String?
  summary          Json?
  started_at       DateTime?
  completed_at     DateTime?
  last_error       String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt
  checks           inventory_audit_check[]

  @@index([status, id])
  @@map("inventory_audit_jobs")
  @@schema("calendar")
}

model inventory_audit_check {
  id                    BigInt    @id @default(autoincrement())
  job_id                BigInt
  site                  String
  target_date           DateTime  @db.Date
  product               String
  calendar_blocked      Boolean
  calendar_sources      Json
  calendar_reservations Json
  status                String    @default("pending")
  observed_state        String?
  severity              String?
  finding_code          String?
  observed_details      Json?
  attempt_count         Int       @default(0)
  claimed_at            DateTime?
  checked_at            DateTime?
  last_error            String?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  job                   inventory_audit_job @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id, site, target_date, product])
  @@index([job_id, status, site, target_date])
  @@index([job_id, severity, target_date])
  @@map("inventory_audit_checks")
  @@schema("calendar")
}

model admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admin")
  @@schema("calendar")
}

model holiday {
  id        Int      @id @default(autoincrement())
  date      DateTime @unique
  name      String
  source    String   @default("custom")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("holidays")
  @@schema("calendar")
}
